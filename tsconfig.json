{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/index.d.ts",
    "src/clean.d.ts",
    "src/components/ui/**/*.d.ts",
    "src/components/ui/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

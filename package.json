{
  "name": "@aether-ui/react",
  "version": "1.0.0",
  "description": "AetherUI — Enterprise AI-First React UI Component Library & Design System",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "aether-ui": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./clean": {
      "types": "./src/clean.d.ts",
      "import": "./dist/lib/clean.js",
      "default": "./dist/lib/clean.js"
    },
    "./ui/*": {
      "types": "./src/components/ui/*.d.ts",
      "import": "./dist/lib/ui/*.js",
      "default": "./dist/lib/ui/*.js"
    },
    "./ui/clean/*": {
      "types": "./src/components/ui/clean/*.d.ts",
      "import": "./dist/lib/ui/clean/*.js",
      "default": "./dist/lib/ui/clean/*.js"
    },
    "./brand": "./src/brand.config.js",
    "./catalog": "./src/affectui-engine/catalog.js",
    "./styles.css": "./dist/lib/styles.css",
    "./dist/lib/styles.css": "./dist/lib/styles.css",
    "./tokens.css": "./design-system/tokens/variables.css",
    "./tokens.json": "./design-system/tokens/design-tokens.json",
    "./tailwind": "./design-system/tokens/tailwind.preset.js"
  },
  "files": [
    "dist/lib",
    "src",
    "design-system",
    "public",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:site": "vite build",
    "build:tokens": "node scripts/build-enterprise-library.mjs",
    "rebrand": "node ./scripts/rebrand.mjs",
    "cli": "node ./bin/cli.mjs",
    "preview": "vite preview --outDir dist/site",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify-consumer.mjs",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "es-module-lexer": "^3.0.4",
    "postcss": "^8.5.32",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}

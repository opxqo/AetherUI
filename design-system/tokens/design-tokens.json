{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "AetherUI / AffectUI Design Tokens",
    "version": "2.0.0",
    "description": "36 core design tokens spanning Type, Shape, Text, Surfaces, Borders, Actions, Status, Palette, Depth, and Motion for Classic and Clean visual engines."
  },
  "tokens": {
    "--aui-font": {
      "$description": "Font family of every component",
      "group": "Type",
      "classic": {
        "light": "\"Inter\", \"InterVariable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      },
      "clean": {
        "light": "\"Inter\", \"InterVariable\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
      }
    },
    "--aui-font-mono": {
      "$description": "Code, keys, IDs and numbers set in mono",
      "group": "Type",
      "classic": {
        "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
      },
      "clean": {
        "light": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
      }
    },
    "--aui-radius": {
      "$description": "Controls: fields, buttons, selects – small and large sizes follow it",
      "group": "Shape",
      "classic": {
        "light": "10px"
      },
      "clean": {
        "light": "7px"
      }
    },
    "--aui-radius-sm": {
      "$description": "Small parts: chips, tags, keys, menu rows",
      "group": "Shape",
      "classic": {
        "light": "7px"
      },
      "clean": {
        "light": "5px"
      }
    },
    "--aui-radius-lg": {
      "$description": "Cards, panels, menus and dialogs",
      "group": "Shape",
      "classic": {
        "light": "16px"
      },
      "clean": {
        "light": "10px"
      }
    },
    "--aui-ink": {
      "$description": "Text, labels and titles",
      "group": "Text",
      "classic": {
        "light": "#171717",
        "dark": "#ededed"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.88)",
        "dark": "rgba(255, 255, 255, 0.9)"
      }
    },
    "--aui-muted": {
      "$description": "Hints, icons and second lines",
      "group": "Text",
      "classic": {
        "light": "#8f8f8f",
        "dark": "#8b8b92"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.45)",
        "dark": "rgba(255, 255, 255, 0.46)"
      }
    },
    "--aui-placeholder": {
      "$description": "Placeholders and the faintest text",
      "group": "Text",
      "classic": {
        "light": "#b5b5b5",
        "dark": "#5c5c63"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.3)",
        "dark": "rgba(255, 255, 255, 0.3)"
      }
    },
    "--aui-surface": {
      "$description": "Fields and cards",
      "group": "Surfaces",
      "classic": {
        "light": "#ffffff",
        "dark": "#19191b"
      },
      "clean": {
        "light": "#ffffff",
        "dark": "#1c1c1e"
      }
    },
    "--aui-subtle": {
      "$description": "Gray layers behind cards, hover washes, chip fills",
      "group": "Surfaces",
      "classic": {
        "light": "#f0f0f0",
        "dark": "#111113"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.03)",
        "dark": "rgba(255, 255, 255, 0.04)"
      }
    },
    "--aui-overlay": {
      "$description": "Menus, popovers and dialogs",
      "group": "Surfaces",
      "classic": {
        "light": "#ffffff",
        "dark": "#19191b"
      },
      "clean": {
        "light": "#ffffff",
        "dark": "#1f1f22"
      }
    },
    "--aui-border": {
      "$description": "Hairline edges at rest",
      "group": "Borders",
      "classic": {
        "light": "#e6e6e8",
        "dark": "#2a2a2e"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.08)",
        "dark": "rgba(255, 255, 255, 0.14)"
      }
    },
    "--aui-border-strong": {
      "$description": "Edges on hover and focus, unchecked boxes",
      "group": "Borders",
      "classic": {
        "light": "#d4d4d8",
        "dark": "#3a3a40"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.13)",
        "dark": "rgba(255, 255, 255, 0.2)"
      }
    },
    "--aui-primary": {
      "$description": "Primary buttons, checked boxes and switches, the send button",
      "group": "Actions",
      "classic": {
        "light": "#171717",
        "dark": "#ededed"
      },
      "clean": {
        "light": "rgba(0, 0, 0, 0.88)",
        "dark": "rgba(255, 255, 255, 0.9)"
      }
    },
    "--aui-on-primary": {
      "$description": "Text and icons on the primary fill",
      "group": "Actions",
      "classic": {
        "light": "#ffffff",
        "dark": "#161618"
      },
      "clean": {
        "light": "#ffffff",
        "dark": "#161618"
      }
    },
    "--aui-focus": {
      "$description": "Keyboard focus ring – keep it at 3:1 contrast or more",
      "group": "Actions",
      "classic": {
        "light": "rgba(0, 96, 226, 0.7)",
        "dark": "rgba(77, 141, 255, 0.8)"
      },
      "clean": {
        "light": "rgba(0, 96, 226, 0.7)",
        "dark": "rgba(77, 141, 255, 0.8)"
      }
    },
    "--aui-danger": {
      "$description": "Errors, failed runs, destructive actions",
      "group": "Status",
      "classic": {
        "light": "#c4320a",
        "dark": "#ff8a7a"
      },
      "clean": {
        "light": "#c4320a",
        "dark": "#ff8a7a"
      }
    },
    "--aui-danger-soft": {
      "$description": "Background of error badges and notices",
      "group": "Status",
      "classic": {
        "light": "rgba(240, 68, 56, 0.1)",
        "dark": "rgba(255, 107, 95, 0.14)"
      },
      "clean": {
        "light": "rgba(240, 68, 56, 0.1)",
        "dark": "rgba(255, 107, 95, 0.14)"
      }
    },
    "--aui-warning": {
      "$description": "Needs attention, waiting for you, limits close",
      "group": "Status",
      "classic": {
        "light": "#b25e00",
        "dark": "#ffb35c"
      },
      "clean": {
        "light": "#b25e00",
        "dark": "#ffb35c"
      }
    },
    "--aui-warning-soft": {
      "$description": "Background of warning badges and notices",
      "group": "Status",
      "classic": {
        "light": "rgba(242, 138, 46, 0.12)",
        "dark": "rgba(242, 161, 92, 0.14)"
      },
      "clean": {
        "light": "rgba(242, 138, 46, 0.12)",
        "dark": "rgba(242, 161, 92, 0.14)"
      }
    },
    "--aui-success": {
      "$description": "Done, connected, copied",
      "group": "Status",
      "classic": {
        "light": "#1e8a4f",
        "dark": "#7dcf9f"
      },
      "clean": {
        "light": "#1e8a4f",
        "dark": "#7dcf9f"
      }
    },
    "--aui-success-soft": {
      "$description": "Background of success badges and notices",
      "group": "Status",
      "classic": {
        "light": "rgba(95, 200, 138, 0.14)",
        "dark": "rgba(125, 207, 159, 0.14)"
      },
      "clean": {
        "light": "rgba(95, 200, 138, 0.14)",
        "dark": "rgba(125, 207, 159, 0.14)"
      }
    },
    "--aui-info": {
      "$description": "Running, live, informational",
      "group": "Status",
      "classic": {
        "light": "#0070d6",
        "dark": "#4fb0fe"
      },
      "clean": {
        "light": "#0070d6",
        "dark": "#4fb0fe"
      }
    },
    "--aui-info-soft": {
      "$description": "Background of info badges and notices",
      "group": "Status",
      "classic": {
        "light": "rgba(1, 144, 254, 0.1)",
        "dark": "rgba(79, 176, 254, 0.14)"
      },
      "clean": {
        "light": "rgba(1, 144, 254, 0.1)",
        "dark": "rgba(79, 176, 254, 0.14)"
      }
    },
    "--aui-blue": {
      "$description": "Info, running, links in charts",
      "group": "Palette",
      "classic": {
        "light": "#0190fe",
        "dark": "#4fb0fe"
      },
      "clean": {
        "light": "#0190fe",
        "dark": "#4fb0fe"
      }
    },
    "--aui-green": {
      "$description": "Success, done",
      "group": "Palette",
      "classic": {
        "light": "#5fc88a",
        "dark": "#7dcf9f"
      },
      "clean": {
        "light": "#5fc88a",
        "dark": "#7dcf9f"
      }
    },
    "--aui-amber": {
      "$description": "Waiting, queued",
      "group": "Palette",
      "classic": {
        "light": "#e8b000",
        "dark": "#e6c24d"
      },
      "clean": {
        "light": "#e8b000",
        "dark": "#e6c24d"
      }
    },
    "--aui-orange": {
      "$description": "Warning, needs you",
      "group": "Palette",
      "classic": {
        "light": "#f28a2e",
        "dark": "#f2a15c"
      },
      "clean": {
        "light": "#f28a2e",
        "dark": "#f2a15c"
      }
    },
    "--aui-red": {
      "$description": "Danger, failed",
      "group": "Palette",
      "classic": {
        "light": "#f04438",
        "dark": "#ff6b5f"
      },
      "clean": {
        "light": "#f04438",
        "dark": "#ff6b5f"
      }
    },
    "--aui-pink": {
      "$description": "Category color",
      "group": "Palette",
      "classic": {
        "light": "#ee3e9e",
        "dark": "#f06db5"
      },
      "clean": {
        "light": "#ee3e9e",
        "dark": "#f06db5"
      }
    },
    "--aui-purple": {
      "$description": "Category color",
      "group": "Palette",
      "classic": {
        "light": "#a651f0",
        "dark": "#b98af0"
      },
      "clean": {
        "light": "#a651f0",
        "dark": "#b98af0"
      }
    },
    "--aui-teal": {
      "$description": "Category color",
      "group": "Palette",
      "classic": {
        "light": "#13b3a0",
        "dark": "#4fc3b4"
      },
      "clean": {
        "light": "#13b3a0",
        "dark": "#4fc3b4"
      }
    },
    "--aui-cyan": {
      "$description": "Category color",
      "group": "Palette",
      "classic": {
        "light": "#14b3f0",
        "dark": "#5cc6ee"
      },
      "clean": {
        "light": "#14b3f0",
        "dark": "#5cc6ee"
      }
    },
    "--aui-shadow-card": {
      "$description": "Edge and lift of cards and fields",
      "group": "Depth",
      "classic": {
        "light": "0 0 0 1px #ececec, 0 1px 2px rgba(0, 0, 0, 0.04)",
        "dark": "0 0 0 1px #2a2a2e, 0 1px 2px rgba(0, 0, 0, 0.2)"
      },
      "clean": {
        "light": "0 0 0 0.5px rgba(0, 0, 0, 0.06), 0 1px 1px -1px rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.05)",
        "dark": "0 0 0 0.5px rgba(255, 255, 255, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.4)"
      }
    },
    "--aui-shadow-popover": {
      "$description": "Menus, popovers and dialogs above the page",
      "group": "Depth",
      "classic": {
        "light": "0 0 0 1px rgba(0, 0, 0, 0.06), 0 18px 40px -12px rgba(0, 0, 0, 0.18), 0 4px 12px -4px rgba(0, 0, 0, 0.06)",
        "dark": "0 0 0 1px rgba(255, 255, 255, 0.06), 0 18px 40px -12px rgba(0, 0, 0, 0.6)"
      },
      "clean": {
        "light": "0 0 0 0.5px rgba(0, 0, 0, 0.08), 0 8px 24px -6px rgba(0, 0, 0, 0.14), 0 2px 6px -2px rgba(0, 0, 0, 0.06)",
        "dark": "0 0 0 0.5px rgba(255, 255, 255, 0.12), 0 12px 32px -8px rgba(0, 0, 0, 0.6)"
      }
    },
    "--aui-ease": {
      "$description": "Easing of enter, glide and morph animations",
      "group": "Motion",
      "classic": {
        "light": "cubic-bezier(0.22, 1, 0.36, 1)"
      },
      "clean": {
        "light": "cubic-bezier(0.22, 1, 0.36, 1)"
      }
    }
  }
}